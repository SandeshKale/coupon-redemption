{
  "name": "@24m/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json && tsc -p tsconfig.json && tsc -p tsconfig.node.json && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "size": "size-limit",
    "mutation": "stryker run",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.json && tsc -p tsconfig.node.json"
  },
  "dependencies": {
    "@24m/shared": "workspace:*",
    "@sentry/browser": "10.75.3",
    "@supabase/auth-js": "2.117.2",
    "@tanstack/react-query": "5.103.2",
    "@zxing/browser": "0.1.5",
    "@zxing/library": "0.21.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.4",
    "valibot": "1.4.2",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@size-limit/file": "14.3.0",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.15.30",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "3.2.7",
    "jsdom": "26.1.0",
    "msw": "2.15.0",
    "size-limit": "14.3.0",
    "tailwindcss": "4.3.3",
    "vite": "6.4.5",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "3.2.7"
  },
  "sideEffects": [
    "**/*.css",
    "./src/main.tsx"
  ]
}
